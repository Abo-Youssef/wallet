{
  "name": "mahfazati-v1",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "npm run build && node scripts/dev-local.mjs",
    "dev:local:empty": "npm run build && node scripts/dev-local.mjs --empty",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "npm run test:core && npm run test:react",
    "test:core": "node --test tests/*.test.mjs",
    "test:react": "vitest run",
    "preview:build": "node scripts/build-preview.mjs",
    "review:probes": "node scripts/review-probes.mjs",
    "backup:check": "node scripts/check-backup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "28.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24"
  }
}
