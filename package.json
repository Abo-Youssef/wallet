{
  "name": "wallet",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "npm run build && node --env-file-if-exists=.env scripts/dev-local.mjs",
    "dev:demo": "npm run build && node --env-file-if-exists=.env scripts/dev-local.mjs --seed-demo",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/postgres-backup.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/postgres-backup.mjs restore",
    "backup:import": "node --env-file-if-exists=.env scripts/import-postgres-backup.mjs",
    "test": "npm run test:core && npm run test:react",
    "test:core": "node --env-file-if-exists=.env --test tests/*.test.mjs",
    "test:react": "vitest run",
    "preview:build": "node scripts/build-preview.mjs",
    "backup:check": "node scripts/check-backup.mjs",
    "backup:legacy:verify": "node scripts/restore-backup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "lucide-react": "1.57.0",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "28.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24"
  }
}
