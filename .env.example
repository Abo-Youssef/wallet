# Private local runtime connection: Neon development / neondb / wallet_app.
# Copy to .env only when it does not exist; never use a VITE_ variable.
# Keep the schema-owner connection in a separate ignored .env.admin.
# Use node --env-file=.env.admin scripts/migrate-postgres.mjs for migrations.
DATABASE_URL=
PORT=43128

# Integration tests need a separate disposable PostgreSQL server.
# Never set this to Neon development or production.
# TEST_DATABASE_URL=
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
